<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!--
      Register .wasm MIME type.
      The <remove> prevents a duplicate-MIME error if IIS already has it defined
      at a parent level (common in IIS 10+).
    -->
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>

    <!--
      COOP + COEP headers are required so the browser grants access to
      SharedArrayBuffer, which ffmpeg.wasm needs for multi-thread mode and
      for some internal typed-array operations.
    -->
    <httpProtocol>
      <customHeaders>
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Embedder-Policy" value="require-corp" />
      </customHeaders>
    </httpProtocol>

    <!--
      SPA fallback: rewrite any 404 back to index.html.
      Requires the IIS URL Rewrite module to be installed.
      Remove this block if the site is served from its own root
      and has no client-side routing (currently the case).
    -->
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
